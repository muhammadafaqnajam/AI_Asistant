# ==============================================================================
# Afaq AI Assistant - Environment Configuration
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI brain (chat, coding, and vision analysis)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# PORT: The port the server runs on (defaults to 3000)
PORT=3000

# APP_URL: The self-referential URL where this application is hosted
APP_URL=http://localhost:3000
